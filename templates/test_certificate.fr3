<TfrxReport Version="2026.2.0" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40255,8557269907" ReportOptions.Description.Text="" ReportOptions.LastChange="46177,4038750926" ScriptLanguage="PascalScript" ScriptText.Text="procedure Memo10OnAfterData(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;      &#13;&#10;    &#13;&#10;end;  &#13;&#10;&#13;&#10;procedure Memo21OnAfterData(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;Certification.&#34;TestPass&#34;&#62; &#60;&#62; 0 then&#13;&#10;  begin&#13;&#10;    Memo21.Text := #10003;&#13;&#10;    Memo21.Font.Name := &#39;Arial&#39;;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo25OnAfterData(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;Certification.&#34;TestFail&#34;&#62; &#60;&#62; 0 then&#13;&#10;  begin&#13;&#10;    Memo25.Text := #10007;&#13;&#10;    Memo25.Font.Name := &#39;Arial&#39;;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo26OnAfterData(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;Certification.&#34;TestNA&#34;&#62; &#60;&#62; 0 then&#13;&#10;  begin&#13;&#10;    Memo26.Text := #10003;&#13;&#10;    Memo26.Font.Name := &#39;Arial&#39;;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;          &#13;&#10;&#13;&#10;procedure CertificationTestTypeOnAfterData(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;if &#60;Certification.&#34;TestType&#34;&#62; &#60;&#62; 1 then  &#13;&#10;begin&#13;&#10;CertificationTestType.visible:=False;&#13;&#10;Picture1.visible:=False;&#13;&#10;Memo44.visible:=False;&#13;&#10;Memo43.visible:=False;    &#13;&#10;Memo42.visible:=False;&#13;&#10;end;&#13;&#10;if &#60;Certification.&#34;TestType&#34;&#62;=1 then  &#13;&#10;begin  &#13;&#10;CertificationTestType.visible:=False;    &#13;&#10;end;&#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure CertificationTestCertPatientSafeOnAfterData(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  memo10.text:=&#39;&#39;;        &#13;&#10;  memo45.text:=&#39;&#39;;&#13;&#10;   memo39.visible:=False;&#13;&#10;  memo40.visible:=False;&#13;&#10;  memo41.visible:=False;&#13;&#10;  memo10.color:=clWhite;      &#13;&#10;    &#13;&#10;    &#13;&#10; if &#60;Certification.&#34;TestCertPatientSafe&#34;&#62;=1 then&#13;&#10; begin&#13;&#10;  memo10.text:=&#39;COMPLIANT&#39;;     &#13;&#10;  memo10.color:=$002CC527;                                                                             &#13;&#10;  end;&#13;&#10;    &#13;&#10; if &#60;Certification.&#34;TestCertPatientSafe&#34;&#62;=0 then  &#13;&#10; begin&#13;&#10;  memo10.text:=&#39;NON-COMPLIANT&#39; ;&#13;&#10;   memo10.color:=$004D4DF2;           &#13;&#10;  end;&#13;&#10;&#13;&#10;   if &#60;Certification.&#34;TestCertPatientSafe&#34;&#62;=2 then  &#13;&#10; begin&#13;&#10;  memo10.text:=&#39;INCOMPLETE&#39; ;&#13;&#10;  // memo10.color:=clOrange;&#13;&#10;  memo45.text:=&#39;This device is either incomplete or has pending tests (refer to notes for details) and, therefore, cannot be deemed &#34;Compliant&#34; at this time.&#39;;        &#13;&#10;  end;      &#13;&#10;&#13;&#10;   if &#60;Certification.&#34;TestCertPatientSafe&#34;&#62;=3 then  &#13;&#10; begin&#13;&#10;  memo10.text:=&#39;CERTIFICATE VOID&#39; ;&#13;&#10;  memo10.color:=$0080FFFF;&#13;&#10;&#13;&#10;  memo39.visible:=true;&#13;&#10;  memo40.visible:=true;&#13;&#10;  memo41.visible:=true;      &#13;&#10;   &#13;&#10;  end;  &#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure Memo51OnAfterData(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;if &#60;Certification.&#34;TestCertType&#34;&#62;=1 then memo51.text:=&#39;OVP&#39;;&#13;&#10;if &#60;Certification.&#34;TestCertType&#34;&#62;=2 then memo51.text:=&#39;Quality Assurance&#39;;&#13;&#10;if &#60;Certification.&#34;TestCertType&#34;&#62;=3 then memo51.text:=&#39;Commission&#39;;&#13;&#10;if &#60;Certification.&#34;TestCertType&#34;&#62;=4 then memo51.text:=&#39;Decontamination&#39;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CertificationTestNextServiceOnAfterData(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Trim(TfrxMemoView(Sender).Text) = &#39;&#39; then&#13;&#10;    TfrxMemoView(Sender).Text := &#39;N/A&#39;;  &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;//Picture1.LoadFromFile(&#39;C:\Program Files\MediManager\&#39;+&#39;logo.bmp&#39;);  &#13;&#10;end.">
